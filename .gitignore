# =============================================================================
# .gitignore — cloudcert-pro
#
# Stack: Node.js 20 · TypeScript · React (Vite) · Express · SQLite
# Tooling: ESLint · Prettier · Vitest · tsx · Tailwind CSS · Docker
# CI/CD: GitHub Actions (ci.yml · container.yml)
# =============================================================================

# =============================================================================
# Dependencies
# =============================================================================
node_modules/

# =============================================================================
# Build output
# =============================================================================
dist/
build/

# =============================================================================
# TypeScript compiler output
# (noEmit is set in tsconfig.json, but guard against local overrides)
# =============================================================================
*.js.map
*.d.ts.map

# =============================================================================
# Test & coverage artefacts
# =============================================================================
coverage/
test-results/

# Vitest / Jest output files found in the workspace root
test-output.txt
test-output2.txt
test_output.txt

# =============================================================================
# Environment / secrets
# Never commit real credentials — use .env.example as the template.
# =============================================================================
.env
.env.*
!.env.example

# =============================================================================
# Database files (SQLite runtime data)
# =============================================================================
*.db
*.db-shm
*.db-wal
# Explicit filenames required by spec (covered by globs above, listed for clarity)
cloudcert.db
cloudcert.db-shm
cloudcert.db-wal

# =============================================================================
# Logs
# =============================================================================
*.log
logs/
execution_log/

# =============================================================================
# OS artefacts
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# Editor / IDE artefacts
# =============================================================================
# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
.idea/
*.iml
*.iws
*.ipr

# VS Code — keep extensions.json (shared tooling recommendations), ignore the rest
.vscode/*
!.vscode/extensions.json

# Vim / Neovim swap files
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# =============================================================================
# Vite / Rollup cache
# =============================================================================
.vite/
.vite-temp/

# =============================================================================
# OpenAPI / SDK generator output
# The sdk/ directory contains generated code — regenerate with npm run generate:sdk:*
# =============================================================================
sdk/typescript-test/dist/
sdk/typescript-test/node_modules/
sdk/typescript-test/typings/
# Generated OpenAPI tools config (openapitools.json is committed; ignore local overrides)
.openapi-generator-ignore

# =============================================================================
# Docker
# =============================================================================
# Local image tarballs produced by the container pipeline
*.tar
/tmp/image.tar

# =============================================================================
# CI / GitHub Actions local runner artefacts
# =============================================================================
# act (local GitHub Actions runner) working directory
.act/

# =============================================================================
# Miscellaneous project-specific files that should not be committed
# =============================================================================
# Personal notes and scratch files
personal_notes/
todos/
prompts/

# MCQ question data and engineering reference docs (local-only content)
data/
engineering-docs/

# One-off utility / check scripts at the root
check-confidence-data.js
test-dashboard-api.js

# Metadata snapshot (regenerated by scripts/generate-all-pca-metadata.js)
metadata.json

# Image assets that are not part of the application source
image.png

# =============================================================================
# Security — private keys and certificate files
# =============================================================================
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets.*
