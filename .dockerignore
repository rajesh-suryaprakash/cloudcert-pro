# =============================================================================
# .dockerignore — excludes files from the Docker build context
#
# Keeps the build context small (faster uploads to the daemon) and prevents
# secrets, local state, and dev artefacts from leaking into the image.
# =============================================================================

# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore

# ── Dependencies (installed fresh inside the image) ──────────────────────────
node_modules

# ── Build output (rebuilt inside the image) ──────────────────────────────────
dist

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Database files (runtime data — never bake into the image) ────────────────
*.db
*.db-shm
*.db-wal

# ── Test artefacts ────────────────────────────────────────────────────────────
coverage
test-output*.txt

# ── Editor and OS artefacts ───────────────────────────────────────────────────
.vscode
.DS_Store
*.log

# ── Documentation and non-runtime files ──────────────────────────────────────
docs
*.md
!README.md

# ── CI/CD ─────────────────────────────────────────────────────────────────────
.github

# ── Kiro workspace files ──────────────────────────────────────────────────────
.kiro

# ── Scripts (not needed at runtime) ──────────────────────────────────────────
scripts

# ── SDK output ────────────────────────────────────────────────────────────────
sdk
