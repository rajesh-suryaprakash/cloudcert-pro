{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/main.tsx",
    "server.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "src/**/*.test.{ts,tsx}",
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/server/**/*.test.ts",
    "scripts/**/*.ts",
    "src/server/middleware/*.ts",
    "src/server/utils/*.ts",
    "src/utils/*.ts",
    "src/types/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "server.ts"],
  "ignore": ["sdk/**", "dist/**", "node_modules/**", "scratch/**", "check_db.ts"],
  "ignoreDependencies": ["pino-pretty"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "optionalPeerDependencies": "off",
    "unlisted": "warn",
    "binaries": "warn",
    "unresolved": "warn"
  }
}
