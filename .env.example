# JWT_SECRET: Secret for signing session tokens (minimum 32 characters)
JWT_SECRET="YOUR_SUPER_SECRET_KEY_MIN_32_CHARS"

# RESET_TOKEN_SECRET: Separate secret for HMAC-signing password reset tokens (minimum 32 characters)
# Must be different from JWT_SECRET so each can be rotated independently
RESET_TOKEN_SECRET="YOUR_RESET_TOKEN_SECRET_MIN_32_CHARS"

# ALLOWED_ORIGIN: Frontend origin allowed to make CORS requests (defaults to Vite dev server)
ALLOWED_ORIGIN="http://localhost:5173"

# SEED_ADMIN_EMAIL: Email for the admin user created during database seeding
SEED_ADMIN_EMAIL="admin@example.com"

# SEED_ADMIN_PASSWORD: Password for the admin user created during database seeding
# Change this immediately in any non-local environment
SEED_ADMIN_PASSWORD="ChangeMe123!"

# SEED_LEARNER_EMAIL: Email for the test learner user created during database seeding
SEED_LEARNER_EMAIL="learner@example.com"

# SEED_LEARNER_PASSWORD: Password for the test learner user created during database seeding
SEED_LEARNER_PASSWORD="ChangeMe123!"

# ── Email / SMTP (optional — omit to use console-log fallback in dev) ──────────
# APP_URL: Public base URL used to build password-reset links
APP_URL="http://localhost:5173"

# SMTP_HOST: SMTP server hostname (e.g. smtp.sendgrid.net, smtp.mailgun.org)
SMTP_HOST=""

# SMTP_PORT: SMTP port — 587 for STARTTLS (default), 465 for SSL
SMTP_PORT="587"

# SMTP_USER: SMTP authentication username / API key
SMTP_USER=""

# SMTP_PASS: SMTP authentication password / API secret
SMTP_PASS=""

# SMTP_FROM: "From" address shown to recipients (defaults to SMTP_USER if omitted)
SMTP_FROM="noreply@cloudcertpro.com"

# MAX_PAUSE_COUNT: Maximum number of exam pauses allowed per session (defaults to 3)
MAX_PAUSE_COUNT="20"

# MAX_TOTAL_PAUSE_MS: Cumulative pause duration limit in milliseconds (defaults to 1800000 milliseconds = 30 minutes)
MAX_TOTAL_PAUSE_MS="18000000"

